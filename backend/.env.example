# Local development values. Put real credentials only in backend/.env or the host's secret settings.
PORT=5001
MONGO_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/antarctic_digital_twin
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SIMULATOR_INTERVAL_MS=10000
